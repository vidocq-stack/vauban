<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written plugin descriptor: maven-plugin-plugin does not support JDK 25 class files -->
<plugin>
    <name>Vauban Maven Plugin</name>
    <description>Build-time CDI bean discovery and proxy generation</description>
    <groupId>io.vidocq.vauban</groupId>
    <artifactId>vauban-maven-plugin</artifactId>
    <version>${project.version}</version>
    <goalPrefix>vauban</goalPrefix>
    <isolatedRealm>false</isolatedRealm>
    <inheritedByDefault>true</inheritedByDefault>
    <mojos>
        <mojo>
            <goal>generate</goal>
            <description>Scan dependency JARs and project classes for CDI beans, write META-INF/vauban-beans.list</description>
            <implementation>io.vidocq.vauban.maven.generate.GenerateMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <phase>process-classes</phase>
            <requiresDependencyResolution>compile+runtime</requiresDependencyResolution>
            <threadSafe>true</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <required>true</required>
                    <editable>false</editable>
                    <description>The Maven project</description>
                </parameter>
                <parameter>
                    <name>outputDirectory</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Output directory for generated files (default: target/classes)</description>
                </parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject"
                         default-value="${project}"/>
                <outputDirectory implementation="java.io.File"
                                 default-value="${project.build.outputDirectory}"/>
            </configuration>
            <requirements>
                <requirement>
                    <role>org.apache.maven.project.MavenProject</role>
                    <field-name>project</field-name>
                </requirement>
            </requirements>
        </mojo>
        <mojo>
            <goal>encrypt</goal>
            <description>Encrypt internal classes of a modular JAR in-place with AES-256-GCM. Exported/opened packages stay clear; all others are encrypted.</description>
            <implementation>io.vidocq.vauban.maven.generate.EncryptMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <phase>package</phase>
            <threadSafe>true</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <required>true</required>
                    <editable>false</editable>
                    <description>The Maven project</description>
                </parameter>
                <parameter>
                    <name>keyAlias</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Key alias stored in SJAR metadata</description>
                </parameter>
                <parameter>
                    <name>sjarKey</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Hex-encoded AES-256 key (64 chars)</description>
                </parameter>
                <parameter>
                    <name>skip</name>
                    <type>boolean</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Skip SJAR encryption</description>
                </parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject"
                         default-value="${project}"/>
                <keyAlias implementation="java.lang.String"
                          default-value="default">${vauban.sjar.keyAlias}</keyAlias>
                <sjarKey implementation="java.lang.String">${vauban.sjar.key}</sjarKey>
                <skip implementation="boolean"
                      default-value="false">${vauban.sjar.skip}</skip>
            </configuration>
            <requirements>
                <requirement>
                    <role>org.apache.maven.project.MavenProject</role>
                    <field-name>project</field-name>
                </requirement>
            </requirements>
        </mojo>
        <mojo>
            <goal>dist</goal>
            <description>Package the application as a distribution ZIP with launch scripts and all dependency JARs</description>
            <implementation>io.vidocq.vauban.maven.generate.DistMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <phase>package</phase>
            <requiresDependencyResolution>compile+runtime</requiresDependencyResolution>
            <threadSafe>true</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <required>true</required>
                    <editable>false</editable>
                    <description>The Maven project</description>
                </parameter>
                <parameter>
                    <name>mainClass</name>
                    <type>java.lang.String</type>
                    <required>true</required>
                    <editable>true</editable>
                    <description>Fully qualified main class name</description>
                </parameter>
                <parameter>
                    <name>distName</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Root directory name inside the ZIP</description>
                </parameter>
                <parameter>
                    <name>scriptName</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Name of the launch scripts (default: run)</description>
                </parameter>
                <parameter>
                    <name>jvmArgs</name>
                    <type>java.lang.String</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Additional JVM arguments</description>
                </parameter>
                <parameter>
                    <name>skip</name>
                    <type>boolean</type>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Skip distribution packaging</description>
                </parameter>
                <parameter>
                    <name>buildDirectory</name>
                    <type>java.io.File</type>
                    <required>false</required>
                    <editable>false</editable>
                    <description>Build directory</description>
                </parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject"
                         default-value="${project}"/>
                <mainClass implementation="java.lang.String">${vauban.dist.mainClass}</mainClass>
                <distName implementation="java.lang.String">${vauban.dist.name}</distName>
                <scriptName implementation="java.lang.String"
                            default-value="run">${vauban.dist.scriptName}</scriptName>
                <jvmArgs implementation="java.lang.String"
                         default-value="">${vauban.dist.jvmArgs}</jvmArgs>
                <skip implementation="boolean"
                      default-value="false">${vauban.dist.skip}</skip>
                <buildDirectory implementation="java.io.File"
                                default-value="${project.build.directory}"/>
            </configuration>
            <requirements>
                <requirement>
                    <role>org.apache.maven.project.MavenProject</role>
                    <field-name>project</field-name>
                </requirement>
            </requirements>
        </mojo>
    </mojos>
</plugin>
