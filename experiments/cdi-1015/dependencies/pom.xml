<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.vidocq.vauban.experiments</groupId>
    <artifactId>cdi-1015-dependencies</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!-- Standalone on purpose: the experiment is not added to Vauban's default reactor. -->
    <properties>
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>
        <heisenberg.version>0.4.0-SNAPSHOT</heisenberg.version>
        <ravel.version>0.4.0-SNAPSHOT</ravel.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-processor</artifactId>
            <version>${vauban.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.heisenberg</groupId>
            <artifactId>heisenberg-cdi-vauban</artifactId>
            <version>${heisenberg.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
            <version>${ravel.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.cdi.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <groupId>jakarta.interceptor</groupId>
            <artifactId>jakarta.interceptor-api</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <directory>${project.basedir}/../target/dependency-resolution</directory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <includeScope>runtime</includeScope>
                    <includeTypes>jar</includeTypes>
                    <prependGroupId>true</prependGroupId>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
