<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>fr.vidocq.vauban</groupId>
        <artifactId>vauban-examples</artifactId>
    </parent>

    <artifactId>example-lib-securized</artifactId>
    <name>Vauban :: Examples :: Securized Library</name>
    <description>CDI library with encrypted beans — distributed as .sjar (Secure JAR)</description>

    <dependencies>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Encrypt the JAR into an SJAR after packaging -->
            <plugin>
                <groupId>fr.vidocq.vauban</groupId>
                <artifactId>vauban-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>encrypt</goal>
                        </goals>
                        <configuration>
                            <keyAlias>example-securized-key</keyAlias>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
